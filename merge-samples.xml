<?xml version="1.0" encoding="utf-8"?>
<merge_samples>
  <production_xml>numi_fhc_run1.xml</production_xml>

  <merged_dir>merged</merged_dir>
  <output_xml>merged-samples.xml</output_xml>

  <numi_db>/exp/uboone/data/uboonebeam/beamdb/numi_v2.db</numi_db>
  <subrun_tree>nuselection/SubRun</subrun_tree>

  <hadd_threads>8</hadd_threads>
  <chunk_size>250</chunk_size>
  <tmp_dir>/tmp</tmp_dir>

  <groups>
    <group name="beam" kind="beam">beam_s0,beam_s1,beam_s2,beam_s3</group>
    <group name="dirt" kind="dirt">dirt_s0,dirt_s1</group>
    <group name="ext" kind="ext">ext_p0,ext_p1,ext_p2</group>
    <group name="strangeness" kind="strangeness">strangeness_run1_fhc</group>
  </groups>
</merge_samples>
